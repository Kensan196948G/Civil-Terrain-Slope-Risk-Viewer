# このファイルは変数名と説明のみを含みます。実値はコミットしないでください。
# ブラウザからDBへ直接接続しない設計のため、DB関連はapps/api (Workers) 側のみで使用します。

# --- apps/api (Cloudflare Workers) ---
# Neon PostgreSQLへの接続文字列 (Hyperdrive経由を推奨)。Wrangler secretで管理する。
DATABASE_URL=

# Cloudflare Access JWT検証用のチーム/Audienceドメイン (限定検証用)
# 両方が設定されている場合のみ、Worker側で Authorization: Bearer の
# Cloudflare Access JWT を検証します (health/live, capabilities, sources は
# openapi 上 security:[] のため対象外)。片方だけ設定すると無効扱いになります。
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# 分あたりのAPIリクエスト上限 (クライアントIP単位)。未設定時は 120。
# エッジ (Cloudflare Access / Rate Limiting) と併用する防御層です。
RATE_LIMIT_PER_MINUTE=120

# 外部データ取得のallowlist設定ファイルパス (packages/adapters)
DATA_SOURCE_ALLOWLIST_PATH=./packages/adapters/allowlist.json

# --- apps/web (React + Vite) ---
# APIのベースURL。未設定なら相対パス "/api/v1" にフォールバックする
# (apps/web/src/elevation/elevation-client.ts)。
#   - 本番 (統合Worker + Static Assets): 設定しない。SPAとAPIが同一オリジンのため
#     相対 "/api/v1" がそのまま同一Workerに届き、CORSも不要。
#   - ローカル開発: 未設定のままでもvite devの /api プロキシ (→ :8787) 経由で動作。
#     別オリジンのWorkerを直接叩く場合のみ絶対URLを設定する。
# VITE_API_BASE_URL=http://localhost:8787/api/v1

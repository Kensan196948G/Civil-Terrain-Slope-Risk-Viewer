{
  "name": "civil-terrain-slope-risk-viewer",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "公開地形データから工事候補地の標高・傾斜・地形分類を可視化するWebシステム",
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "pnpm --parallel -r --filter=./apps/* run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tests/fixtures/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "build": "pnpm -r run build",
    "deploy:mvp": "pnpm --filter ./apps/web run build && pnpm --filter ./apps/api exec wrangler deploy --env mvp",
    "deploy:prod": "pnpm --filter ./apps/web run build && pnpm --filter ./apps/api exec wrangler deploy",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "fixtures:generate": "node --experimental-strip-types tests/fixtures/generate/generate.ts",
    "fixtures:test": "vitest run --config tests/fixtures/vitest.config.ts",
    "fixtures:typecheck": "tsc --noEmit -p tests/fixtures/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@3>brace-expansion": ">=2.1.4 <3",
      "minimatch@9>brace-expansion": ">=2.1.4 <3",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.17",
      "undici": ">=7.29.0",
      "postcss": ">=8.5.23"
    }
  }
}
